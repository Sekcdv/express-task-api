NODE_ENV=development
APP_VERSION=1.0.0
PORT=3000
PUBLIC_API_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb+srv://<USUARIO>:<CONTRASENA_CODIFICADA>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=task_api
JWT_SECRET=<GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES>
JWT_EXPIRES_IN=1h
JWT_ISSUER=task-api-express
JWT_AUDIENCE=task-api-client
# Produccion (Render):
#   Backend:  https://task-api-express-reemplaza.onrender.com
#   Frontend: https://task-manager-frontend-reemplaza.onrender.com
# Para desarrollo local con el frontend de Vite, usa CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=https://task-manager-frontend-reemplaza.onrender.com
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
